FROM node:26-alpine

RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY . .
# Node 25+ 公式イメージは corepack を同梱しないので先に入れる
RUN npm i -g corepack@latest && corepack enable pnpm && pnpm add -g turbo
RUN pnpm install
EXPOSE 3003

ENV TURBO_TELEMETRY_DISABLED=1

VOLUME [ "/app/node_modules", "/app/live/node_modules"]

CMD ["pnpm","dev", "--filter=live"]
