FROM node:26-alpine

RUN apk add --no-cache libc6-compat

# Set working directory
WORKDIR /app

COPY . .

# Node 25+ 公式イメージは corepack を同梱しないので先に入れる
RUN npm i -g corepack@latest && corepack enable pnpm && pnpm add -g turbo
RUN pnpm install

EXPOSE 3002

ENV VITE_SPACE_BASE_PATH="/spaces"

VOLUME [ "/app/node_modules", "/app/apps/space/node_modules"]

CMD ["pnpm", "dev", "--filter=space"]
