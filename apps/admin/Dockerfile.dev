FROM node:26-alpine
RUN apk add --no-cache libc6-compat
# Set working directory
WORKDIR /app

COPY . .

# Node 25+ 公式イメージは corepack を同梱しないので先に入れる
RUN npm i -g corepack@latest && corepack enable pnpm && pnpm add -g turbo
RUN pnpm install

ENV VITE_ADMIN_BASE_PATH="/god-mode"

EXPOSE 3000

VOLUME [ "/app/node_modules", "/app/admin/node_modules" ]

CMD ["pnpm", "dev", "--filter=admin"]
